# Copy to .env (gitignored) and fill in. Every value here overrides the
# matching entry in config/settings.yaml.

# --- IBKR (TWS / Gateway) ---
# TWS paper 7497 | TWS live 7496 | Gateway paper 4002 | Gateway live 4001
TRACER_IBKR_HOST=127.0.0.1
TRACER_IBKR_PORT=7497
TRACER_IBKR_CLIENT_ID=11

# --- WRDS / CRSP ---
# The PASSWORD is never set here. WRDS authenticates via libpq's pgpass file:
#   Windows : %APPDATA%\postgresql\pgpass.conf
#   Linux   : ~/.pgpass   (chmod 600)
# Format    : wrds-pgdata.wharton.upenn.edu:9737:wrds:<username>:<password>
TRACER_WRDS_USERNAME=

# --- Logging ---
TRACER_LOG_LEVEL=INFO
